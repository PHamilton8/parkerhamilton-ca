---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Wealthsimple 2027 - Parker Hamilton';
const documentTitle = 'Wealthsimple 2027';
const videoSrc = '/assets/application/wealthsimple-application-video.mp4';
const posterSrc = '/assets/application/wealthsimple-application-video-poster.webp';
---
<BaseLayout
  title={documentTitle}
  description="Wealthsimple 2027 application video from Parker Hamilton."
  canonicalPath="/wealthsimple-2026"
  robots="noindex, noarchive"
>
  <article class="application-page">
    <h1>{pageTitle}</h1>
    <div class="application-video-wrap">
      <video
        controls
        playsinline
        preload="metadata"
        poster={posterSrc}
        aria-label="Wealthsimple 2027 application video by Parker Hamilton"
      >
        <source src={videoSrc} type="video/mp4" />
        <track kind="captions" src="/assets/application/wealthsimple-application-video.vtt" srclang="en" label="English" default />
        Your browser does not support the video element.
      </video>
    </div>
  </article>
</BaseLayout>

<style>
  .application-page {
    max-width: var(--content-main);
    margin-inline: auto;
    padding: clamp(4rem, 7vw, 6.5rem) clamp(1.125rem, 3vw, 2.25rem) clamp(5rem, 8vw, 7rem);
  }

  .application-page h1 {
    margin: 0;
    max-width: 100%;
    font-size: clamp(2.85rem, 5.5vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.052em;
  }

  .application-video-wrap {
    width: min(100%, 76rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .application-video-wrap video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.8rem;
  }

  @media (max-width: 35rem) {
    .application-page {
      padding-top: 3.25rem;
      padding-inline: 1.125rem;
    }

    .application-page h1 {
      font-size: clamp(2.35rem, 11.5vw, 3.25rem);
    }

    .application-video-wrap {
      margin-top: 2rem;
    }
  }

  /* WS-PORTRAIT-MAIN-GAP-02: keep the shared utility sticky-footer shell,
     but on Wealthsimple's portrait regime use the spare main-axis space as
     three deliberate composition bands instead of one dead band after video.
     The fractional rows collapse to zero when the article needs natural flow. */
  @media (max-width: 51.25rem) {
    :global(body.route-utility > main) {
      display: flex;
      flex-direction: column;
    }

    .application-page {
      flex: 1 1 auto;
      width: 100%;
      display: grid;
      grid-template-rows:
        minmax(0, 0.8fr)
        auto
        minmax(2rem, 0.8fr)
        auto
        minmax(0, 1.4fr);
    }

    .application-page h1 {
      grid-row: 2;
    }

    .application-video-wrap {
      grid-row: 4;
      margin-top: 0;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmithManoeuvreCalculator from '../../components/calculators/SmithManoeuvreCalculator.astro';

const title = 'Smith Manoeuvre Model';
const description = 'A calculator for comparing leveraged and non-leveraged investing outcomes under different debt, investment, and tax assumptions.';
---

<BaseLayout title={title} description={description} canonicalPath="/work/smith-manoeuvre">
  <section class="smith-tool-page">
    <header class="smith-tool-header">
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <SmithManoeuvreCalculator />
  </section>
</BaseLayout>

<style>
  .smith-tool-page {
    min-height: 70vh;
    padding: clamp(3.75rem, 7vw, 6.5rem) clamp(1.125rem, 3vw, 2.25rem) clamp(5rem, 8vw, 7rem);
  }

  .smith-tool-header {
    max-width: var(--content-main);
    margin-inline: auto;
  }

  .smith-tool-header h1 {
    max-width: 58rem;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .smith-tool-header p {
    max-width: 49rem;
    margin: 1.2rem 0 0;
    color: var(--color-text);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.55;
  }

  @media (max-width: 35rem) {
    .smith-tool-page { padding-top: 2.9rem; padding-bottom: 4rem; }
    .smith-tool-header h1 { font-size: clamp(2.6rem, 14vw, 3.7rem); }
    .smith-tool-header p { margin-top: 0.9rem; }
  }
</style>

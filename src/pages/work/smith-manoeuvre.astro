  }

  .fairness-copy {
    max-width: 62rem;
  }

  .fairness-copy h2 {
    color: var(--color-on-deep);
  }

  .fairness-copy > p:last-child {
    max-width: 50rem;
    margin: 1.35rem 0 0;
    color: var(--color-on-deep-muted);
    font-size: 1.05rem;
    line-height: 1.68;
  }

  .cash-identity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: stretch;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cash-path {
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid rgb(199 218 215 / 0.35);
    border-radius: var(--radius-md);
    background: rgb(247 251 250 / 0.05);
  }

  .cash-label {
    color: var(--color-on-deep-muted);
  }

  .cash-equation {
    margin: 0.7rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.42;
  }

  .cash-equation span {
    color: var(--color-on-deep-muted);
  }

  .cash-divider {
    align-self: center;
    color: var(--color-on-deep-muted);
    font-size: 2rem;
    font-weight: 750;
  }

  .fairness-footnote {
    max-width: 58rem;
    margin: 1.45rem 0 0;
    color: var(--color-on-deep-muted);
    font-size: 0.9rem;
    line-height: 1.62;
  }

  .split-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    max-width: none;
  }

  .split-heading > p {
    padding-bottom: 0.25rem;
  }

  .audit-grid,
  .rules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2.4rem, 5vw, 4rem);
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    background: var(--color-line-strong);
  }

  .audit-grid article,
  .rules-grid article {
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--color-surface);
  }

  .audit-grid h3,
  .rules-grid h3,
  .comparison-panel h3,
  .disclosure-grid h3 {
    margin: 0.55rem 0 0;
    color: var(--color-ink);
    font-size: 1.18rem;
    line-height: 1.28;
  }

  .audit-grid article > p:not(.audit-number, .audit-check),
  .rules-grid p,
  .comparison-panel p,
  .comparison-panel li,
  .disclosure-grid p {
    color: var(--color-text);
    font-size: 0.94rem;
    line-height: 1.62;
  }

  .audit-check {
    margin: 1rem 0 0;
    color: var(--color-deep-teal);
    font-size: 0.82rem;
    font-weight: 720;
    line-height: 1.45;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(2.3rem, 5vw, 4rem);
  }

  .comparison-panel {
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    background: var(--color-surface);

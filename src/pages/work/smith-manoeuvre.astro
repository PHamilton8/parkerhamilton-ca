    display: block;
    margin-top: 0.45rem;
    font-size: 0.89rem;
    line-height: 1.32;
  }

  .mechanism-flow small {
    display: block;
    margin-top: 0.32rem;
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.38;
  }

  .fairness-section {
    background: var(--color-deep-teal);
    color: var(--color-on-deep);
  }

  .fairness-inner {
    padding-block: clamp(4.75rem, 8vw, 7.5rem);
  }

  .section-kicker-light {

---
import {
  experiment4Results,
  experimentSummary,
  fixedExperimentalProjectionRows,
} from '../../data/compound-growth/fixedExperimentalData';
import {
  calculateCompoundGrowthProjection,
  compoundGrowthDefaultInput,
  selectCompoundGrowthDisplayPoints,
} from '../../lib/calculators/compoundGrowth';

type Study = {
  number: number;
  ultra_short_label: string;
  one_sentence: string;
};

type StudySummary = {
  program: { number_of_experiments: number };
  experiments: Study[];
};

type ConditionResult = {
  mean: number;
  sd: number;
};

type PublicResult = {
  line_graph: ConditionResult;
  table: ConditionResult;
  effect_b: number;
  p: string;
  d: number;
};

type Experiment4PublicResults = {
  estimated_growth_ratio: PublicResult;
  growth_confidence: PublicResult;
  retirement_goal_achievability: PublicResult;
  planned_retirement_contributions_cad_per_month: PublicResult;
};

type Experiment4Data = {
  estimated_growth_task: {
    interpretation: { correct_value: number };
  };
  public_facing_results: Experiment4PublicResults;
  serial_mediation: {
    causal_language_warning: string;
  };
};

const studies = (experimentSummary as unknown as StudySummary).experiments;
const experiment4 = experiment4Results as unknown as Experiment4Data;
const results = experiment4.public_facing_results;

const formatCad = (value: number, digits = 0) =>
  new Intl.NumberFormat('en-CA', {
    style: 'currency',
    currency: 'CAD',
    maximumFractionDigits: digits,
    minimumFractionDigits: digits,
  }).format(value);

const fixedChart = {
  width: 760,
  height: 390,
  left: 72,
  right: 34,
  top: 28,
  bottom: 56,
  max: 600_000,
};
const fixedX = (year: number) =>
  fixedChart.left +
  (year / 40) * (fixedChart.width - fixedChart.left - fixedChart.right);
const fixedY = (value: number) =>
  fixedChart.top +
  (1 - value / fixedChart.max) *
    (fixedChart.height - fixedChart.top - fixedChart.bottom);
const fixedBalancePoints = fixedExperimentalProjectionRows
  .map((row) => `${fixedX(row.years_invested)},${fixedY(row.total_account_balance_cad)}`)
  .join(' ');
const fixedContributionPoints = fixedExperimentalProjectionRows
  .map((row) => `${fixedX(row.years_invested)},${fixedY(row.cumulative_contributions_cad)}`)
  .join(' ');
const fixedYTicks = [0, 200_000, 400_000, 600_000];

const defaultProjection = calculateCompoundGrowthProjection(compoundGrowthDefaultInput);
const defaultDisplayPoints = selectCompoundGrowthDisplayPoints(defaultProjection);

const resultRows = [
  {
    id: 'egr',
    label: 'Estimated Growth Ratio',
    table: results.estimated_growth_ratio.table.mean,
    graph: results.estimated_growth_ratio.line_graph.mean,
    tableSd: results.estimated_growth_ratio.table.sd,
    graphSd: results.estimated_growth_ratio.line_graph.sd,
    max: experiment4.estimated_growth_task.interpretation.correct_value,
    unit: 'ratio',
    effect: `b = ${results.estimated_growth_ratio.effect_b.toFixed(2)}, p ${results.estimated_growth_ratio.p}, d = ${results.estimated_growth_ratio.d.toFixed(2)}`,
    reference: experiment4.estimated_growth_task.interpretation.correct_value,
    currency: false,
  },
  {
    id: 'growth-confidence',
    label: 'Growth confidence',
    table: results.growth_confidence.table.mean,
    graph: results.growth_confidence.line_graph.mean,
    tableSd: results.growth_confidence.table.sd,
    graphSd: results.growth_confidence.line_graph.sd,
    max: 100,
    unit: '0–100 scale',
    effect: `b = ${results.growth_confidence.effect_b.toFixed(2)}, p ${results.growth_confidence.p}, d = ${results.growth_confidence.d.toFixed(2)}`,
    reference: null,
    currency: false,
  },
  {
    id: 'achievability',
    label: 'Retirement-goal achievability',
    table: results.retirement_goal_achievability.table.mean,
    graph: results.retirement_goal_achievability.line_graph.mean,
    tableSd: results.retirement_goal_achievability.table.sd,
    graphSd: results.retirement_goal_achievability.line_graph.sd,
    max: 100,
    unit: '0–100 scale',
    effect: `b = ${results.retirement_goal_achievability.effect_b.toFixed(2)}, p ${results.retirement_goal_achievability.p}, d = ${results.retirement_goal_achievability.d.toFixed(2)}`,
    reference: null,
    currency: false,
  },
  {
    id: 'planned-contributions',
    label: 'Planned monthly retirement contributions',
    table: results.planned_retirement_contributions_cad_per_month.table.mean,
    graph: results.planned_retirement_contributions_cad_per_month.line_graph.mean,
    tableSd: results.planned_retirement_contributions_cad_per_month.table.sd,
    graphSd: results.planned_retirement_contributions_cad_per_month.line_graph.sd,
    max: 250,
    unit: 'CAD per month',
    effect: `b = ${results.planned_retirement_contributions_cad_per_month.effect_b.toFixed(2)}, p = ${results.planned_retirement_contributions_cad_per_month.p}, d = ${results.planned_retirement_contributions_cad_per_month.d.toFixed(2)}`,
    reference: null,
    currency: true,
  },
] as const;

const studyAnswers = studies.map((study) => ({
  ...study,
  answer:
    study.number === 4
      ? 'A significant serial indirect effect was consistent with the proposed pathway.'
      : study.one_sentence,
}));
---

<div class="cg-suite" data-compound-growth-suite>
  <header class="cg-suite__intro">
    <p class="cg-suite__credential">MSc · Marketing Research & Behavioural Science · University of Ottawa</p>
    <h1>Compound Growth & Retirement Investing</h1>
  </header>

  <section class="cg-module cg-module--fixed" aria-labelledby="fixed-title" data-fixed-recreation>
    <div class="cg-module__heading">
      <div>
        <p class="cg-kicker">Controlled comparison</p>
        <h2 id="fixed-title">Interactive recreation of the experimental values.</h2>
      </div>
      <p>Switch between a table and line graph. The underlying values are identical in both views.</p>
    </div>

    <div class="cg-switch" role="tablist" aria-label="Experimental projection display">
      <button id="fixed-tab-table" type="button" role="tab" aria-selected="false" aria-controls="fixed-panel-table" tabindex="-1" data-fixed-view="table">Table</button>
      <button id="fixed-tab-graph" type="button" role="tab" aria-selected="true" aria-controls="fixed-panel-graph" tabindex="0" data-fixed-view="graph">Line graph</button>
    </div>

    <div id="fixed-panel-table" class="cg-panel" role="tabpanel" aria-labelledby="fixed-tab-table" hidden data-fixed-panel="table">
      <div class="cg-table-wrap">
        <table class="cg-data-table">
          <caption>Fixed experimental projection values</caption>
          <thead><tr><th scope="col">Years invested</th><th scope="col">Your contributions</th><th scope="col">Total account balance</th></tr></thead>
          <tbody>
            {fixedExperimentalProjectionRows.map((row) => (
              <tr><th scope="row">{row.years_invested}</th><td>{formatCad(row.cumulative_contributions_cad)}</td><td>{formatCad(row.total_account_balance_cad)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div id="fixed-panel-graph" class="cg-panel" role="tabpanel" aria-labelledby="fixed-tab-graph" data-fixed-panel="graph">
      <p class="cg-chart-summary">The projected account balance rises from $0 to $559,461 over 40 years while cumulative contributions rise to $48,000. Both series use the same fixed values as the table view.</p>
      <div class="cg-chart-frame">
        <svg class="cg-chart" viewBox={`0 0 ${fixedChart.width} ${fixedChart.height}`} role="img" aria-labelledby="fixed-chart-title fixed-chart-desc">
          <title id="fixed-chart-title">Fixed experimental projection shown as a line graph</title>
          <desc id="fixed-chart-desc">Two series show cumulative contributions and total account balance at nine fixed five-year intervals from year zero to year forty.</desc>
          {fixedYTicks.map((tick) => (
            <>
              <line class="cg-grid" x1={fixedChart.left} y1={fixedY(tick)} x2={fixedChart.width - fixedChart.right} y2={fixedY(tick)} />
              <text class="cg-axis-label" x={fixedChart.left - 12} y={fixedY(tick) + 4} text-anchor="end">{tick === 0 ? '$0' : `$${tick / 1000}k`}</text>
            </>
          ))}
          <line class="cg-axis" x1={fixedChart.left} y1={fixedChart.top} x2={fixedChart.left} y2={fixedChart.height - fixedChart.bottom} />
          <line class="cg-axis" x1={fixedChart.left} y1={fixedChart.height - fixedChart.bottom} x2={fixedChart.width - fixedChart.right} y2={fixedChart.height - fixedChart.bottom} />
          {fixedExperimentalProjectionRows.map((row) => (
            <text class="cg-axis-label" x={fixedX(row.years_invested)} y={fixedChart.height - fixedChart.bottom + 25} text-anchor="middle">{row.years_invested}</text>
          ))}
          <polyline class="cg-series cg-series--balance" points={fixedBalancePoints} />
          <polyline class="cg-series cg-series--contributions" points={fixedContributionPoints} />
          {fixedExperimentalProjectionRows.map((row) => (
            <>
              <circle class="cg-point cg-point--balance cg-fixed-point" cx={fixedX(row.years_invested)} cy={fixedY(row.total_account_balance_cad)} r="5" tabindex="0" role="button" aria-label={`${row.years_invested} years invested, total account balance ${formatCad(row.total_account_balance_cad)}, contributions ${formatCad(row.cumulative_contributions_cad)}`} data-year={row.years_invested} data-balance={row.total_account_balance_cad} data-contributions={row.cumulative_contributions_cad} data-series="Total account balance" />
              <circle class="cg-point cg-point--contributions cg-fixed-point" cx={fixedX(row.years_invested)} cy={fixedY(row.cumulative_contributions_cad)} r="5" tabindex="0" role="button" aria-label={`${row.years_invested} years invested, contributions ${formatCad(row.cumulative_contributions_cad)}, total account balance ${formatCad(row.total_account_balance_cad)}`} data-year={row.years_invested} data-balance={row.total_account_balance_cad} data-contributions={row.cumulative_contributions_cad} data-series="Your contributions" />
            </>
          ))}
          <text class="cg-end-label cg-end-label--balance" x={fixedChart.width - fixedChart.right - 2} y={fixedY(559_461) - 14} text-anchor="end">Total account balance — $559,461</text>
          <text class="cg-end-label" x={fixedChart.width - fixedChart.right - 2} y={fixedY(48_000) - 14} text-anchor="end">Your contributions — $48,000</text>
          <text class="cg-axis-title" x={(fixedChart.width + fixedChart.left - fixedChart.right) / 2} y={fixedChart.height - 8} text-anchor="middle">Years invested</text>
        </svg>
      </div>
      <p class="cg-point-detail" id="fixed-point-detail" aria-live="polite">Focus or tap a point to inspect its exact stored values.</p>
      <div class="sr-only">
        <table>
          <caption>Fixed experimental values available while the graph is selected</caption>
          <thead><tr><th scope="col">Years invested</th><th scope="col">Your contributions</th><th scope="col">Total account balance</th></tr></thead>
          <tbody>{fixedExperimentalProjectionRows.map((row) => (<tr><th scope="row">{row.years_invested}</th><td>{formatCad(row.cumulative_contributions_cad)}</td><td>{formatCad(row.total_account_balance_cad)}</td></tr>))}</tbody>
        </table>
      </div>
    </div>
    <p class="cg-source-note">Portfolio recreation — not the original experimental interface. The historical stimulus values are stored directly; visitor controls do not recalculate them.</p>
  </section>

  <section class="cg-module" aria-labelledby="egr-title" data-egr-explainer>
    <div class="cg-module__heading">
      <div><p class="cg-kicker">Perceived acceleration</p><h2 id="egr-title">Two gains, one ratio</h2></div>
      <p>Estimated Growth Ratio compares how much larger the later perceived gain is than the earlier one.</p>
    </div>
    <div class="cg-switch cg-switch--plain" aria-label="Estimated Growth Ratio example">
      <button type="button" data-egr-preset="equal-gains" aria-pressed="false">Equal gains</button>
      <button type="button" data-egr-preset="experimental-projection" aria-pressed="true">Experimental projection</button>
    </div>
    <div class="cg-egr">
      <div class="cg-egr__points" aria-label="Growth estimates">
        <div><span>Year 20</span><strong data-egr-year20>3.6×</strong></div>
        <div><span>Year 30</span><strong data-egr-year30>10.3×</strong></div>
        <div><span>Year 40</span><strong data-egr-year40>27.8×</strong></div>
      </div>
      <div class="cg-egr__gains">
        <div class="cg-egr__gain"><span>Earlier gain</span><strong data-egr-earlier>10.3 − 3.6 = 6.7</strong></div>
        <div class="cg-egr__division" aria-hidden="true">÷</div>
        <div class="cg-egr__gain"><span>Later gain</span><strong data-egr-later>27.8 − 10.3 = 17.5</strong></div>
      </div>
      <div class="cg-egr__result" aria-live="polite">
        <span>Estimated Growth Ratio</span><strong data-egr-ratio>2.61</strong><p data-egr-interpretation>2.61 = the normative ratio for the experimental projection.</p>
      </div>
    </div>
    <p class="cg-persistent-note">Values above 1 indicate that the later gain is perceived as larger than the earlier gain.</p>
    <p class="cg-source-note" data-egr-source>This preset uses the correct growth estimates from the experimental projection; it is not a participant mean.</p>
  </section>

  <section class="cg-module" aria-labelledby="study-title" data-study-progression>
    <div class="cg-module__heading">
      <div><p class="cg-kicker">Five experiments</p><h2 id="study-title">How the research question narrowed</h2></div>
      <p>Each experiment tested a different part of the proposed account. The fifth study did not establish a unique connected-line mechanism.</p>
    </div>
    <ol class="cg-study-list">
      {studyAnswers.map((study) => (
        <li><article class="cg-study" tabindex="0" data-study-card><span class="cg-study__number" aria-hidden="true">{String(study.number).padStart(2, '0')}</span><div><h3>Experiment {study.number}: {study.ultra_short_label}</h3><p>{study.answer}</p></div></article></li>
      ))}
    </ol>
  </section>

  <section class="cg-module" aria-labelledby="results-title" data-experiment-four>
    <div class="cg-module__heading">
      <div><p class="cg-kicker">Experiment 4 · aggregate results</p><h2 id="results-title">The main group differences</h2></div>
      <p>Presentation condition was randomized. The mediators and planned contributions were measured; the statistical sequence does not independently establish their causal ordering.</p>
    </div>
    <div class="cg-result-list">
      {resultRows.map((result) => (
        <article class="cg-result" data-result-row={result.id}>
          <div class="cg-result__header"><h3>{result.label}</h3><span>{result.unit}</span></div>
          <div class="cg-result__track-wrap">
            <div class="cg-result__track" aria-hidden="true">{result.reference !== null && (<span class="cg-result__reference" style={`--position:${(result.reference / result.max) * 100}%`}></span>)}</div>
            <button type="button" class="cg-result__marker cg-result__marker--table" style={`--position:${Math.min(100, (result.table / result.max) * 100)}%`} aria-label={`${result.label}, table condition mean ${result.currency ? formatCad(result.table, 2) : result.table.toFixed(2)}, ${result.unit}`} data-result-condition="Table" data-result-label={result.label} data-result-mean={result.currency ? formatCad(result.table, 2) : result.table.toFixed(2)} data-result-sd={result.tableSd.toFixed(2)} data-result-unit={result.unit} data-result-effect={result.effect}><span aria-hidden="true">T</span></button>
            <button type="button" class="cg-result__marker cg-result__marker--graph" style={`--position:${Math.min(100, (result.graph / result.max) * 100)}%`} aria-label={`${result.label}, line graph condition mean ${result.currency ? formatCad(result.graph, 2) : result.graph.toFixed(2)}, ${result.unit}`} data-result-condition="Line graph" data-result-label={result.label} data-result-mean={result.currency ? formatCad(result.graph, 2) : result.graph.toFixed(2)} data-result-sd={result.graphSd.toFixed(2)} data-result-unit={result.unit} data-result-effect={result.effect}><span aria-hidden="true">G</span></button>
          </div>
          <div class="cg-result__values"><span><b>Table</b> {result.currency ? formatCad(result.table, 2) : result.table.toFixed(2)}</span><span><b>Line graph</b> {result.currency ? formatCad(result.graph, 2) : result.graph.toFixed(2)}</span>{result.reference !== null && <span><b>Correct reference</b> {result.reference.toFixed(2)}</span>}</div>
        </article>
      ))}
    </div>
    <div class="cg-result-detail" id="experiment-four-detail" aria-live="polite">Focus or tap a condition marker for its mean, standard deviation, and comparison statistic.</div>
  </section>

  <section class="cg-explorer-boundary" aria-labelledby="explorer-title" data-explorer>
    <div class="cg-explorer-boundary__statement">
      <p class="cg-kicker">Separate exploratory model</p>
      <h2 id="explorer-title">Explore a separate annual-compounding scenario. These adjustable projections were not tested in the experiments.</h2>
      <p>Change the assumptions, then switch between the same results shown as a table or line graph.</p>
    </div>
    <div class="cg-explorer">
      <form class="cg-explorer__controls" data-explorer-form novalidate>
        <div class="cg-field"><label for="cg-starting-age">Starting age</label><input id="cg-starting-age" name="startingAge" type="number" min="18" max="70" step="1" value="25" inputmode="numeric" /><span class="cg-field-error" data-error-for="startingAge" aria-live="polite"></span></div>
        <div class="cg-field"><label for="cg-retirement-age">Retirement age</label><input id="cg-retirement-age" name="retirementAge" type="number" min="19" max="80" step="1" value="65" inputmode="numeric" /><span class="cg-field-error" data-error-for="retirementAge" aria-live="polite"></span></div>
        <div class="cg-field"><label for="cg-annual-contribution">Annual contribution</label><div class="cg-input-affix"><span aria-hidden="true">$</span><input id="cg-annual-contribution" name="annualContribution" type="number" min="0" max="100000" step="100" value="1200" inputmode="decimal" /></div><span class="cg-field-error" data-error-for="annualContribution" aria-live="polite"></span></div>
        <div class="cg-field"><label for="cg-annual-return">Assumed annual return</label><div class="cg-input-affix cg-input-affix--suffix"><input id="cg-annual-return" name="annualReturn" type="number" min="0" max="20" step="0.1" value="10" inputmode="decimal" /><span aria-hidden="true">%</span></div><span class="cg-field-error" data-error-for="annualReturn" aria-live="polite"></span></div>
      </form>
      <p class="cg-explorer__global-error" data-explorer-error role="status"></p>
      <dl class="cg-summary" aria-label="Exploratory projection summary">
        <div><dt>Years invested</dt><dd data-summary-years>{defaultProjection.yearsInvested}</dd></div>
        <div><dt>Total contributions</dt><dd data-summary-contributions>{formatCad(defaultProjection.totalContributions)}</dd></div>
        <div><dt>Final projected balance</dt><dd data-summary-balance>{formatCad(defaultProjection.finalBalance)}</dd></div>
        <div><dt>Projected investment growth</dt><dd data-summary-growth>{formatCad(defaultProjection.projectedInvestmentGrowth)}</dd></div>
      </dl>
      <div class="cg-switch" role="tablist" aria-label="Exploratory projection display">
        <button id="explorer-tab-table" type="button" role="tab" aria-selected="true" aria-controls="explorer-panel-table" tabindex="0" data-explorer-view="table">Table</button>
        <button id="explorer-tab-graph" type="button" role="tab" aria-selected="false" aria-controls="explorer-panel-graph" tabindex="-1" data-explorer-view="graph">Line graph</button>
      </div>
      <div id="explorer-panel-table" class="cg-panel" role="tabpanel" aria-labelledby="explorer-tab-table" data-explorer-panel="table">
        <div class="cg-table-wrap"><table class="cg-data-table" data-explorer-table><caption>Exploratory annual-compounding projection</caption><thead><tr><th scope="col">Age</th><th scope="col">Years invested</th><th scope="col">Cumulative contributions</th><th scope="col">Projected account balance</th></tr></thead><tbody>{defaultDisplayPoints.map((point) => (<tr><th scope="row">{point.age}</th><td>{point.yearsInvested}</td><td>{formatCad(point.cumulativeContributions)}</td><td>{formatCad(point.projectedBalance)}</td></tr>))}</tbody></table></div>
      </div>
      <div id="explorer-panel-graph" class="cg-panel" role="tabpanel" aria-labelledby="explorer-tab-graph" hidden data-explorer-panel="graph">
        <p class="cg-chart-summary" data-explorer-chart-summary>From age 25 to 65, 40 year-end contributions total $48,000. Under this separate annual model, the final projected balance is {formatCad(defaultProjection.finalBalance)}.</p>
        <div class="cg-chart-frame"><svg class="cg-chart cg-chart--explorer" viewBox="0 0 760 390" role="img" aria-label="Exploratory annual-compounding projection" data-explorer-chart></svg></div>
        <p class="cg-point-detail" data-explorer-point-detail aria-live="polite">Focus or tap a point to inspect the generated annual-model values.</p>
        <div class="sr-only" data-explorer-a11y-table></div>
      </div>
      <div class="cg-assumptions"><p><strong>Annual model:</strong> the existing balance grows once per year, then the annual contribution is added at year-end. Starting balance is $0. This exploratory scenario was not tested in the experiments.</p><p>Illustrative projection only. It does not model fees, taxes, inflation, return volatility, or changes in contributions.</p></div>
    </div>
  </section>
</div>

<script>
  import {
    CompoundGrowthInputError,
    calculateCompoundGrowthProjection,
    selectCompoundGrowthDisplayPoints,
  } from '../../lib/calculators/compoundGrowth';

  type ViewName = 'table' | 'graph';
  const currency = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });

  function setupTabs(root: ParentNode, buttonSelector: string, panelSelector: string, dataAttribute: 'fixedView' | 'explorerView') {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>(buttonSelector));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(panelSelector));
    const activate = (view: ViewName, focus = false) => {
      buttons.forEach((button) => {
        const selected = button.dataset[dataAttribute] === view;
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
        button.tabIndex = selected ? 0 : -1;
        if (selected && focus) button.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.panelView !== view; });
    };
    panels.forEach((panel) => {
      if (panel.hasAttribute('data-fixed-panel')) panel.dataset.panelView = panel.getAttribute('data-fixed-panel') || '';
      if (panel.hasAttribute('data-explorer-panel')) panel.dataset.panelView = panel.getAttribute('data-explorer-panel') || '';
    });
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(button.dataset[dataAttribute] as ViewName));
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + buttons.length) % buttons.length;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % buttons.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = buttons.length - 1;
        const next = buttons[nextIndex];
        activate(next.dataset[dataAttribute] as ViewName, true);
      });
    });
  }

  const fixedRoot = document.querySelector<HTMLElement>('[data-fixed-recreation]');
  if (fixedRoot) {
    setupTabs(fixedRoot, '[data-fixed-view]', '[data-fixed-panel]', 'fixedView');
    const detail = fixedRoot.querySelector<HTMLElement>('#fixed-point-detail');
    const showFixedPoint = (point: SVGElement) => {
      if (!detail) return;
      detail.textContent = `${point.dataset.year} years invested — contributions ${currency.format(Number(point.dataset.contributions))}; total account balance ${currency.format(Number(point.dataset.balance))}.`;
    };
    fixedRoot.querySelectorAll<SVGElement>('.cg-fixed-point').forEach((point) => {
      point.addEventListener('focus', () => showFixedPoint(point));
      point.addEventListener('click', () => showFixedPoint(point));
      point.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); showFixedPoint(point); } });
    });
  }

  const egrRoot = document.querySelector<HTMLElement>('[data-egr-explainer]');
  if (egrRoot) {
    const presets = {
      'equal-gains': { year20: 3.6, year30: 10.3, year40: 17, ratio: '1.00', interpretation: '1.00 = equal perceived gains across the two intervals.', source: 'Illustrative equal-gains example — not participant data.' },
      'experimental-projection': { year20: 3.6, year30: 10.3, year40: 27.8, ratio: '2.61', interpretation: '2.61 = the normative ratio for the experimental projection.', source: 'This preset uses the correct growth estimates from the experimental projection; it is not a participant mean.' },
    } as const;
    const buttons = Array.from(egrRoot.querySelectorAll<HTMLButtonElement>('[data-egr-preset]'));
    const year20 = egrRoot.querySelector<HTMLElement>('[data-egr-year20]');
    const year30 = egrRoot.querySelector<HTMLElement>('[data-egr-year30]');
    const year40 = egrRoot.querySelector<HTMLElement>('[data-egr-year40]');
    const earlier = egrRoot.querySelector<HTMLElement>('[data-egr-earlier]');
    const later = egrRoot.querySelector<HTMLElement>('[data-egr-later]');
    const ratio = egrRoot.querySelector<HTMLElement>('[data-egr-ratio]');
    const interpretation = egrRoot.querySelector<HTMLElement>('[data-egr-interpretation]');
    const source = egrRoot.querySelector<HTMLElement>('[data-egr-source]');
    const renderEgr = (presetId: keyof typeof presets) => {
      const preset = presets[presetId];
      const earlierGain = preset.year30 - preset.year20;
      const laterGain = preset.year40 - preset.year30;
      if (year20) year20.textContent = `${preset.year20.toFixed(1)}×`;
      if (year30) year30.textContent = `${preset.year30.toFixed(1)}×`;
      if (year40) year40.textContent = `${preset.year40.toFixed(1)}×`;
      if (earlier) earlier.textContent = `${preset.year30.toFixed(1)} − ${preset.year20.toFixed(1)} = ${earlierGain.toFixed(1)}`;
      if (later) later.textContent = `${preset.year40.toFixed(1)} − ${preset.year30.toFixed(1)} = ${laterGain.toFixed(1)}`;
      if (ratio) ratio.textContent = preset.ratio;
      if (interpretation) interpretation.textContent = preset.interpretation;
      if (source) source.textContent = preset.source;
      buttons.forEach((button) => button.setAttribute('aria-pressed', button.dataset.egrPreset === presetId ? 'true' : 'false'));
    };
    buttons.forEach((button) => button.addEventListener('click', () => renderEgr(button.dataset.egrPreset as keyof typeof presets)));
  }

  const studyRoot = document.querySelector<HTMLElement>('[data-study-progression]');
  if (studyRoot) {
    const cards = Array.from(studyRoot.querySelectorAll<HTMLElement>('[data-study-card]'));
    const activateStudy = (active: HTMLElement) => cards.forEach((card) => card.classList.toggle('is-active', card === active));
    cards.forEach((card) => {
      card.addEventListener('focus', () => activateStudy(card));
      card.addEventListener('pointerenter', () => activateStudy(card));
      card.addEventListener('pointerdown', () => activateStudy(card));
    });
  }

  const resultRoot = document.querySelector<HTMLElement>('[data-experiment-four]');
  if (resultRoot) {
    const detail = resultRoot.querySelector<HTMLElement>('#experiment-four-detail');
    const markers = Array.from(resultRoot.querySelectorAll<HTMLButtonElement>('.cg-result__marker'));
    let selected: HTMLButtonElement | null = null;
    const showResult = (marker: HTMLButtonElement, persistent = false) => {
      markers.forEach((item) => item.classList.toggle('is-selected', item === marker && persistent));
      if (persistent) selected = marker;
      if (detail) detail.textContent = `${marker.dataset.resultLabel} — ${marker.dataset.resultCondition}: mean ${marker.dataset.resultMean}, SD ${marker.dataset.resultSd}, ${marker.dataset.resultUnit}. Comparison: ${marker.dataset.resultEffect}.`;
    };
    markers.forEach((marker) => {
      marker.addEventListener('focus', () => showResult(marker, false));
      marker.addEventListener('mouseenter', () => showResult(marker, false));
      marker.addEventListener('click', () => showResult(marker, true));
    });
    document.addEventListener('pointerdown', (event) => { if (selected && !resultRoot.contains(event.target as Node)) { selected.classList.remove('is-selected'); selected = null; } });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && selected) { selected.classList.remove('is-selected'); selected = null; } });
  }

  const explorerRoot = document.querySelector<HTMLElement>('[data-explorer]');
  if (explorerRoot) {
    setupTabs(explorerRoot, '[data-explorer-view]', '[data-explorer-panel]', 'explorerView');
    const form = explorerRoot.querySelector<HTMLFormElement>('[data-explorer-form]');
    const globalError = explorerRoot.querySelector<HTMLElement>('[data-explorer-error]');
    const summaryYears = explorerRoot.querySelector<HTMLElement>('[data-summary-years]');
    const summaryContributions = explorerRoot.querySelector<HTMLElement>('[data-summary-contributions]');
    const summaryBalance = explorerRoot.querySelector<HTMLElement>('[data-summary-balance]');
    const summaryGrowth = explorerRoot.querySelector<HTMLElement>('[data-summary-growth]');
    const tableBody = explorerRoot.querySelector<HTMLTableSectionElement>('[data-explorer-table] tbody');
    const chart = explorerRoot.querySelector<SVGSVGElement>('[data-explorer-chart]');
    const chartSummary = explorerRoot.querySelector<HTMLElement>('[data-explorer-chart-summary]');
    const pointDetail = explorerRoot.querySelector<HTMLElement>('[data-explorer-point-detail]');
    const a11yTable = explorerRoot.querySelector<HTMLElement>('[data-explorer-a11y-table]');
    let debounceId: number | undefined;
    const fieldError = (name: string) => explorerRoot.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    const clearErrors = () => {
      explorerRoot.querySelectorAll<HTMLElement>('.cg-field-error').forEach((element) => { element.textContent = ''; });
      explorerRoot.querySelectorAll<HTMLInputElement>('input').forEach((input) => input.removeAttribute('aria-invalid'));
      if (globalError) globalError.textContent = '';
    };
    const setFieldError = (name: string, message: string) => {
      const input = form?.elements.namedItem(name);
      if (input instanceof HTMLInputElement) input.setAttribute('aria-invalid', 'true');
      const error = fieldError(name);
      if (error) error.textContent = message;
    };
    const niceMax = (value: number) => {
      if (value <= 0) return 1_000;
      const padded = value * 1.08;
      const magnitude = 10 ** Math.floor(Math.log10(padded));
      const normalized = padded / magnitude;
      const step = normalized <= 2 ? 0.5 : normalized <= 5 ? 1 : 2;
      return Math.ceil(normalized / step) * step * magnitude;
    };
    const renderTable = (points: readonly { age: number; yearsInvested: number; cumulativeContributions: number; projectedBalance: number }[]) => {
      if (!tableBody) return;
      tableBody.replaceChildren(...points.map((point) => { const row = document.createElement('tr'); row.innerHTML = `<th scope="row">${point.age}</th><td>${point.yearsInvested}</td><td>${currency.format(point.cumulativeContributions)}</td><td>${currency.format(point.projectedBalance)}</td>`; return row; }));
      if (a11yTable) a11yTable.innerHTML = `<table><caption>Exploratory annual-compounding values available while the graph is selected</caption><thead><tr><th scope="col">Age</th><th scope="col">Years invested</th><th scope="col">Cumulative contributions</th><th scope="col">Projected account balance</th></tr></thead><tbody>${points.map((point) => `<tr><th scope="row">${point.age}</th><td>${point.yearsInvested}</td><td>${currency.format(point.cumulativeContributions)}</td><td>${currency.format(point.projectedBalance)}</td></tr>`).join('')}</tbody></table>`;
    };
    const renderChart = (points: readonly { age: number; yearsInvested: number; cumulativeContributions: number; projectedBalance: number }[]) => {
      if (!chart || points.length === 0) return;
      const width = 760, height = 390, left = 72, right = 34, top = 28, bottom = 56;
      const minAge = points[0].age, maxAge = points[points.length - 1].age;
      const yMax = niceMax(Math.max(...points.map((point) => point.projectedBalance)));
      const x = (age: number) => left + ((age - minAge) / Math.max(1, maxAge - minAge)) * (width - left - right);
      const y = (value: number) => top + (1 - value / yMax) * (height - top - bottom);
      const balancePolyline = points.map((point) => `${x(point.age)},${y(point.projectedBalance)}`).join(' ');
      const contributionPolyline = points.map((point) => `${x(point.age)},${y(point.cumulativeContributions)}`).join(' ');
      const ticks = [0, yMax / 3, (2 * yMax) / 3, yMax];
      const tickLabel = (value: number) => value >= 1_000_000 ? `$${(value / 1_000_000).toFixed(value % 1_000_000 === 0 ? 0 : 1)}m` : `$${Math.round(value / 1000)}k`;
      chart.innerHTML = `<title>Exploratory annual-compounding projection</title><desc>Generated values for cumulative contributions and projected account balance from age ${minAge} to ${maxAge}.</desc>${ticks.map((tick) => `<line class="cg-grid" x1="${left}" y1="${y(tick)}" x2="${width - right}" y2="${y(tick)}"></line><text class="cg-axis-label" x="${left - 12}" y="${y(tick) + 4}" text-anchor="end">${tickLabel(tick)}</text>`).join('')}<line class="cg-axis" x1="${left}" y1="${top}" x2="${left}" y2="${height - bottom}"></line><line class="cg-axis" x1="${left}" y1="${height - bottom}" x2="${width - right}" y2="${height - bottom}"></line>${points.map((point) => `<text class="cg-axis-label" x="${x(point.age)}" y="${height - bottom + 25}" text-anchor="middle">${point.age}</text>`).join('')}<polyline class="cg-series cg-series--balance" points="${balancePolyline}"></polyline><polyline class="cg-series cg-series--contributions" points="${contributionPolyline}"></polyline>${points.map((point) => `<circle class="cg-point cg-point--balance cg-explorer-point" cx="${x(point.age)}" cy="${y(point.projectedBalance)}" r="5" tabindex="0" role="button" aria-label="Age ${point.age}, projected balance ${currency.format(point.projectedBalance)}, cumulative contributions ${currency.format(point.cumulativeContributions)}" data-age="${point.age}" data-years="${point.yearsInvested}" data-balance="${point.projectedBalance}" data-contributions="${point.cumulativeContributions}"></circle><circle class="cg-point cg-point--contributions cg-explorer-point" cx="${x(point.age)}" cy="${y(point.cumulativeContributions)}" r="5" tabindex="0" role="button" aria-label="Age ${point.age}, cumulative contributions ${currency.format(point.cumulativeContributions)}, projected balance ${currency.format(point.projectedBalance)}" data-age="${point.age}" data-years="${point.yearsInvested}" data-balance="${point.projectedBalance}" data-contributions="${point.cumulativeContributions}"></circle>`).join('')}<text class="cg-axis-title" x="${(width + left - right) / 2}" y="${height - 8}" text-anchor="middle">Age</text>`;
      chart.querySelectorAll<SVGElement>('.cg-explorer-point').forEach((point) => {
        const show = () => { if (pointDetail) pointDetail.textContent = `Age ${point.dataset.age} · ${point.dataset.years} years invested — cumulative contributions ${currency.format(Number(point.dataset.contributions))}; projected balance ${currency.format(Number(point.dataset.balance))}.`; };
        point.addEventListener('focus', show); point.addEventListener('click', show); point.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); show(); } });
      });
    };
    const renderProjection = () => {
      if (!form) return;
      clearErrors();
      const startingAgeInput = form.elements.namedItem('startingAge'), retirementAgeInput = form.elements.namedItem('retirementAge'), contributionInput = form.elements.namedItem('annualContribution'), returnInput = form.elements.namedItem('annualReturn');
      if (!(startingAgeInput instanceof HTMLInputElement) || !(retirementAgeInput instanceof HTMLInputElement) || !(contributionInput instanceof HTMLInputElement) || !(returnInput instanceof HTMLInputElement)) return;
      const fields = [['startingAge', startingAgeInput], ['retirementAge', retirementAgeInput], ['annualContribution', contributionInput], ['annualReturn', returnInput]] as const;
      for (const [name, input] of fields) {
        if (!Number.isFinite(input.valueAsNumber)) { setFieldError(name, 'Enter a valid number.'); return; }
        if (!input.validity.valid) { setFieldError(name, input.validationMessage || 'Check this value.'); return; }
      }
      try {
        const projection = calculateCompoundGrowthProjection({ startingAge: startingAgeInput.valueAsNumber, retirementAge: retirementAgeInput.valueAsNumber, startingPortfolio: 0, annualContribution: contributionInput.valueAsNumber, annualReturn: returnInput.valueAsNumber / 100 });
        const points = selectCompoundGrowthDisplayPoints(projection);
        if (summaryYears) summaryYears.textContent = String(projection.yearsInvested);
        if (summaryContributions) summaryContributions.textContent = currency.format(projection.totalContributions);
        if (summaryBalance) summaryBalance.textContent = currency.format(projection.finalBalance);
        if (summaryGrowth) summaryGrowth.textContent = currency.format(projection.projectedInvestmentGrowth);
        if (chartSummary) chartSummary.textContent = `From age ${projection.input.startingAge} to ${projection.input.retirementAge}, ${projection.yearsInvested} year-end contributions total ${currency.format(projection.totalContributions)}. Under this separate annual model, the final projected balance is ${currency.format(projection.finalBalance)}.`;
        renderTable(points); renderChart(points);
      } catch (error) {
        if (error instanceof CompoundGrowthInputError) {
          if (error.code === 'RETIREMENT_AGE_NOT_AFTER_STARTING_AGE' || error.code === 'RETIREMENT_AGE_OUT_OF_RANGE' || error.code === 'PROJECTION_HORIZON_EXCEEDS_MAXIMUM') setFieldError('retirementAge', error.message);
          else if (error.code === 'STARTING_AGE_OUT_OF_RANGE' || error.code === 'AGE_NOT_WHOLE_YEAR') setFieldError('startingAge', error.message);
          else if (error.code === 'NEGATIVE_ANNUAL_CONTRIBUTION') setFieldError('annualContribution', error.message);
          else if (error.code === 'RETURN_NOT_GREATER_THAN_NEGATIVE_ONE') setFieldError('annualReturn', error.message);
          else if (globalError) globalError.textContent = error.message;
        } else if (globalError) globalError.textContent = 'This combination could not be projected. Check the inputs and try again.';
      }
    };
    const scheduleRender = () => { window.clearTimeout(debounceId); debounceId = window.setTimeout(renderProjection, 120); };
    form?.addEventListener('input', scheduleRender);
    form?.addEventListener('change', renderProjection);
    renderProjection();
  }
</script>


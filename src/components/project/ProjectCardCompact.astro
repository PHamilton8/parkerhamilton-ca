---
import type { Project } from '../../data/projects';
import ProjectMetadata from './ProjectMetadata.astro';
interface Props { project: Project }
const { project } = Astro.props;
const mediaPath = `/assets/projects/${project.slug}/${project.mediaKind === 'reporting' ? 'workflow' : project.mediaKind}.svg`;
---
<article class="project-card secondary-card">
  <div class="project-meta">
    <span class="project-number">{project.number}</span>
  </div>
  <h3>{project.title}</h3>
  <p class="project-premise">{project.premise}</p>
  <ProjectMetadata tags={project.tags} />
  <figure class="secondary-visual">
    <img src={mediaPath} alt="" loading="lazy" />
  </figure>
  <a class="project-link" href={project.route}><span>Case study</span><span aria-hidden="true">↗</span></a>
</article>

---
import {
  runSmithScenario,
} from '../../lib/calculators/smithManoeuvre';
import {
  SMITH_DEFAULT_INPUTS,
  buildSmithAnnualSeries,
  buildSmithChartGeometry,
  formatSmithAxisCurrency,
  formatSmithCurrency,
  formatSmithCurrencyDetailed,
  formatSmithPayoffMonth,
  formatSmithPercent,
} from '../../lib/calculators/smithManoeuvreView';

const defaultResult = runSmithScenario({ ...SMITH_DEFAULT_INPUTS });
const defaultSeries = buildSmithAnnualSeries(defaultResult);
const defaultChart = buildSmithChartGeometry(defaultSeries);
const defaultHorizon = SMITH_DEFAULT_INPUTS.horizonYears;
---

<section class="smith-calculator" data-smith-calculator aria-labelledby="smith-calculator-title">
  <div class="smith-boundary">
    <div>
      <p class="smith-boundary-label" id="smith-calculator-title">Educational scenario model</p>
      <p>This calculator compares a simplified Smith Manoeuvre scenario with an equal-cash non-Smith baseline. It does not determine tax deductibility or whether the strategy is suitable for you.</p>
    </div>
    <span>All entered values stay in this browser session.</span>
  </div>

  <div class="smith-tool-grid">
    <section class="smith-input-panel" aria-labelledby="smith-input-heading">
      <div class="smith-panel-heading">
        <div>
          <p class="smith-section-label">Scenario</p>
          <h2 id="smith-input-heading">Assumptions</h2>
        </div>
        <button class="smith-reset" type="button" data-reset-defaults>Reset defaults</button>
      </div>

      <fieldset class="smith-fieldset">
        <legend>Property & mortgage</legend>
        <div class="smith-field-grid">
          <div class="smith-field">
            <label for="smith-home-value">Home value <span>(CAD)</span></label>
            <input id="smith-home-value" data-smith-field="homeValue" type="number" inputmode="decimal" step="1000" value={SMITH_DEFAULT_INPUTS.homeValue} aria-describedby="hint-homeValue error-homeValue warning-homeValue" />
            <p class="smith-hint" id="hint-homeValue">Held constant throughout the model.</p>
            <p class="smith-warning" id="warning-homeValue" data-warning-for="homeValue" hidden></p>
            <p class="smith-error" id="error-homeValue" data-error-for="homeValue" hidden></p>
          </div>

          <div class="smith-field">
            <label for="smith-mortgage-balance">Mortgage balance <span>(CAD)</span></label>
            <input id="smith-mortgage-balance" data-smith-field="mortgageBalance" type="number" inputmode="decimal" step="1000" value={SMITH_DEFAULT_INPUTS.mortgageBalance} aria-describedby="hint-mortgageBalance error-mortgageBalance warning-mortgageBalance" />
            <p class="smith-hint" id="hint-mortgageBalance">Public model boundary: at most 80% of home value.</p>
            <p class="smith-warning" id="warning-mortgageBalance" data-warning-for="mortgageBalance" hidden></p>
            <p class="smith-error" id="error-mortgageBalance" data-error-for="mortgageBalance" hidden></p>
          </div>

          <div class="smith-field">
            <label for="smith-amortization">Remaining amortization <span>(years)</span></label>
            <input id="smith-amortization" data-smith-field="remainingAmortizationYears" type="number" inputmode="numeric" step="1" value={SMITH_DEFAULT_INPUTS.remainingAmortizationYears} aria-describedby="hint-remainingAmortizationYears error-remainingAmortizationYears warning-remainingAmortizationYears" />
            <p class="smith-hint" id="hint-remainingAmortizationYears">Whole years. Usual calculator range: 1–30.</p>
            <p class="smith-warning" id="warning-remainingAmortizationYears" data-warning-for="remainingAmortizationYears" hidden></p>
            <p class="smith-error" id="error-remainingAmortizationYears" data-error-for="remainingAmortizationYears" hidden></p>
          </div>

          <div class="smith-field">
            <label for="smith-horizon">Scenario horizon <span>(years)</span></label>
            <input id="smith-horizon" data-smith-field="horizonYears" type="number" inputmode="numeric" step="1" value={SMITH_DEFAULT_INPUTS.horizonYears} aria-describedby="hint-horizonYears error-horizonYears warning-horizonYears" />
            <p class="smith-hint" id="hint-horizonYears">Whole years. Usual calculator range: 1–40.</p>
            <p class="smith-warning" id="warning-horizonYears" data-warning-for="horizonYears" hidden></p>
            <p class="smith-error" id="error-horizonYears" data-error-for="horizonYears" hidden></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="smith-fieldset">
        <legend>Rates & return</legend>
        <div class="smith-field-grid">
          <div class="smith-field">
            <label for="smith-mortgage-rate">Quoted annual mortgage rate <span>(%)</span></label>
            <input id="smith-mortgage-rate" data-smith-field="quotedMortgageRate" type="number" inputmode="decimal" step="0.1" value={SMITH_DEFAULT_INPUTS.quotedMortgageRate * 100} aria-describedby="hint-quotedMortgageRate error-quotedMortgageRate warning-quotedMortgageRate" />
            <p class="smith-hint" id="hint-quotedMortgageRate">Canadian nominal rate with semi-annual compounding.</p>
            <p class="smith-warning" id="warning-quotedMortgageRate" data-warning-for="quotedMortgageRate" hidden></p>
            <p class="smith-error" id="error-quotedMortgageRate" data-error-for="quotedMortgageRate" hidden></p>
          </div>

          <div class="smith-field">
            <label for="smith-heloc-rate">Annual HELOC rate <span>(%)</span></label>
            <input id="smith-heloc-rate" data-smith-field="annualHelocRate" type="number" inputmode="decimal" step="0.1" value={SMITH_DEFAULT_INPUTS.annualHelocRate * 100} aria-describedby="hint-annualHelocRate error-annualHelocRate warning-annualHelocRate" />
            <p class="smith-hint" id="hint-annualHelocRate">Modelled as a simplified monthly approximation.</p>
            <p class="smith-warning" id="warning-annualHelocRate" data-warning-for="annualHelocRate" hidden></p>
            <p class="smith-error" id="error-annualHelocRate" data-error-for="annualHelocRate" hidden></p>
          </div>

          <div class="smith-field smith-field-wide">
            <label for="smith-investment-return">Expected annual investment return <span>(%)</span></label>
            <input id="smith-investment-return" data-smith-field="expectedAnnualInvestmentReturn" type="number" inputmode="decimal" step="0.1" value={SMITH_DEFAULT_INPUTS.expectedAnnualInvestmentReturn * 100} aria-describedby="hint-expectedAnnualInvestmentReturn error-expectedAnnualInvestmentReturn warning-expectedAnnualInvestmentReturn" />
            <p class="smith-hint" id="hint-expectedAnnualInvestmentReturn">Effective annual assumption. The model uses a constant deterministic return.</p>
            <p class="smith-warning" id="warning-expectedAnnualInvestmentReturn" data-warning-for="expectedAnnualInvestmentReturn" hidden></p>
            <p class="smith-error" id="error-expectedAnnualInvestmentReturn" data-error-for="expectedAnnualInvestmentReturn" hidden></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="smith-fieldset smith-tax-group">
        <legend>Tax assumptions</legend>
        <p class="smith-group-note">These are illustrative assumptions, not tax determinations.</p>
        <div class="smith-field-grid">
          <div class="smith-field">
            <label for="smith-tax-rate">Marginal tax-rate proxy <span>(%)</span></label>
            <input id="smith-tax-rate" data-smith-field="marginalTaxRateProxy" type="number" inputmode="decimal" step="1" value={SMITH_DEFAULT_INPUTS.marginalTaxRateProxy * 100} aria-describedby="hint-marginalTaxRateProxy error-marginalTaxRateProxy warning-marginalTaxRateProxy" />
            <p class="smith-hint" id="hint-marginalTaxRateProxy">Used only for the estimated tax-offset proxy.</p>
            <p class="smith-warning" id="warning-marginalTaxRateProxy" data-warning-for="marginalTaxRateProxy" hidden></p>
            <p class="smith-error" id="error-marginalTaxRateProxy" data-error-for="marginalTaxRateProxy" hidden></p>
          </div>

          <div class="smith-field">
            <label for="smith-deductible-share">Deductible-interest assumption <span>(%)</span></label>
            <input id="smith-deductible-share" data-smith-field="deductibleInterestAssumption" type="number" inputmode="decimal" step="1" value={SMITH_DEFAULT_INPUTS.deductibleInterestAssumption * 100} aria-describedby="hint-deductibleInterestAssumption error-deductibleInterestAssumption warning-deductibleInterestAssumption" />
            <p class="smith-hint" id="hint-deductibleInterestAssumption">Share of modelled HELOC interest assumed eligible for the proxy.</p>
            <p class="smith-warning" id="warning-deductibleInterestAssumption" data-warning-for="deductibleInterestAssumption" hidden></p>
            <p class="smith-error" id="error-deductibleInterestAssumption" data-error-for="deductibleInterestAssumption" hidden></p>
          </div>
        </div>
      </fieldset>

      <div class="smith-actions">
        <button class="smith-update" type="button" data-update-scenario>Update scenario</button>
        <p class="smith-status" data-smith-status aria-live="polite"></p>
      </div>
      <noscript><p class="smith-noscript">Interactive recalculation requires JavaScript. The default scenario remains visible.</p></noscript>
    </section>

    <section class="smith-results" aria-labelledby="smith-results-heading">
      <header class="smith-results-header">
        <div>
          <p class="smith-section-label">Comparison</p>
          <h2 id="smith-results-heading">Results</h2>
        </div>
        <p data-horizon-label>{defaultHorizon}-year scenario</p>
      </header>

      <div class="smith-difference">
        <span>Illustrative net-position difference</span>
        <strong data-output="netDifference">{formatSmithCurrency(defaultResult.illustrativeNetPositionDifference)}</strong>
        <p>Smith scenario minus the equal-cash baseline at the end of the selected horizon.</p>
      </div>

      <div class="smith-scenario-grid">
        <section class="smith-scenario" aria-labelledby="smith-scenario-heading">
          <h3 id="smith-scenario-heading">Smith scenario</h3>
          <dl>
            <div><dt>Mortgage</dt><dd data-output="smithMortgage">{formatSmithCurrency(defaultResult.endingMortgageBalance)}</dd></div>
            <div><dt>HELOC</dt><dd data-output="smithHeloc">{formatSmithCurrency(defaultResult.endingHelocBalance)}</dd></div>
            <div><dt>Taxable portfolio</dt><dd data-output="smithPortfolio">{formatSmithCurrency(defaultResult.endingSmithTaxablePortfolio)}</dd></div>
            <div class="smith-net-row"><dt>Net financial position</dt><dd data-output="smithNet">{formatSmithCurrency(defaultResult.smithNetFinancialPosition)}</dd></div>
          </dl>
        </section>

        <section class="smith-scenario" aria-labelledby="baseline-scenario-heading">
          <h3 id="baseline-scenario-heading">Equal-cash baseline</h3>
          <dl>
            <div><dt>Mortgage</dt><dd data-output="baselineMortgage">{formatSmithCurrency(defaultResult.endingBaselineMortgageBalance)}</dd></div>
            <div><dt>HELOC</dt><dd>$0</dd></div>
            <div><dt>Investment portfolio</dt><dd data-output="baselinePortfolio">{formatSmithCurrency(defaultResult.endingBaselinePortfolio)}</dd></div>
            <div class="smith-net-row"><dt>Net financial position</dt><dd data-output="baselineNet">{formatSmithCurrency(defaultResult.baselineNetFinancialPosition)}</dd></div>
          </dl>
        </section>
      </div>

      <p class="smith-baseline-note">The baseline uses the same mortgage cash budget and invests an amount equal to the Smith scenario's HELOC-interest cash outflow each month.</p>

      <dl class="smith-detail-grid" aria-label="Scenario details">
        <div><dt>Monthly mortgage budget</dt><dd data-output="mortgageBudget">{formatSmithCurrencyDetailed(defaultResult.scheduledMonthlyMortgageBudget)}</dd></div>
        <div><dt>Cumulative HELOC interest paid</dt><dd data-output="helocInterest">{formatSmithCurrency(defaultResult.cumulativeHelocInterestPaid)}</dd></div>
        <div><dt>Estimated cumulative tax offset</dt><dd data-output="taxOffset">{formatSmithCurrency(defaultResult.estimatedCumulativeTaxOffset)}</dd></div>
        <div><dt>Maximum secured LTV</dt><dd data-output="maxLtv">{formatSmithPercent(defaultResult.maxSecuredLtv)}</dd></div>
        <div><dt>Ending secured LTV</dt><dd data-output="endingLtv">{formatSmithPercent(defaultResult.endingSecuredLtv)}</dd></div>
        <div><dt>Smith mortgage payoff</dt><dd data-output="smithPayoff">{formatSmithPayoffMonth(defaultResult.smithMortgagePayoffMonth)}</dd></div>
        <div><dt>Baseline mortgage payoff</dt><dd data-output="baselinePayoff">{formatSmithPayoffMonth(defaultResult.baselineMortgagePayoffMonth)}</dd></div>
      </dl>

      <section class="smith-chart-section" aria-labelledby="smith-chart-title-text">
        <div class="smith-chart-heading">
          <div>
            <h3 id="smith-chart-title-text">Net position over time</h3>
            <p>Year-end model points plus the selected horizon endpoint.</p>
          </div>
          <ul class="smith-legend" aria-label="Chart series">
            <li><span class="smith-key"></span>Smith scenario</li>
            <li><span class="baseline-key"></span>Equal-cash baseline</li>
          </ul>
        </div>

        <div class="smith-chart-frame">
          <svg data-smith-chart viewBox={`0 0 ${defaultChart.width} ${defaultChart.height}`} role="img" aria-labelledby="smith-svg-title smith-svg-desc">
            <title id="smith-svg-title">Smith scenario and equal-cash baseline net position over time</title>
            <desc id="smith-svg-desc">A line chart using the same yearly values available in the data table below.</desc>
            <g data-chart-grid aria-hidden="true">
              {defaultChart.ticks.map((tick) => (
                <g>
                  <line x1={defaultChart.left} y1={tick.y} x2={defaultChart.width - defaultChart.right} y2={tick.y}></line>
                  <text x={defaultChart.left - 10} y={tick.y + 4} text-anchor="end">{formatSmithAxisCurrency(tick.value)}</text>
                </g>
              ))}
              <line class="smith-zero-line" x1={defaultChart.left} y1={defaultChart.zeroY} x2={defaultChart.width - defaultChart.right} y2={defaultChart.zeroY}></line>
              <text class="smith-x-label" x={defaultChart.left} y={defaultChart.height - 14}>0</text>
              <text class="smith-x-label" x={defaultChart.width - defaultChart.right} y={defaultChart.height - 14} text-anchor="end">{defaultHorizon} years</text>
            </g>
            <path class="smith-line" data-chart-path="smith" d={defaultChart.smithPath}></path>
            <path class="baseline-line" data-chart-path="baseline" d={defaultChart.baselinePath}></path>
            <g data-chart-points aria-hidden="true">
              {defaultChart.points.map((point) => (
                <g data-chart-point data-year={point.year} data-smith={point.smithNetFinancialPosition} data-baseline={point.baselineNetFinancialPosition}></g>
              ))}
            </g>
          </svg>
        </div>

        <details class="smith-data-details">
          <summary>View yearly comparison data</summary>
          <div class="smith-table-region" role="region" tabindex="0" aria-label="Yearly Smith and baseline net-position comparison">
            <table>
              <caption>Values used in the net-position chart</caption>
              <thead>
                <tr>
                  <th scope="col">Year</th>
                  <th scope="col">Smith scenario</th>
                  <th scope="col">Equal-cash baseline</th>
                </tr>
              </thead>
              <tbody data-comparison-table>
                {defaultSeries.map((point) => (
                  <tr data-comparison-row data-year={point.year} data-smith={point.smithNetFinancialPosition} data-baseline={point.baselineNetFinancialPosition}>
                    <th scope="row">{Number.isInteger(point.year) ? point.year : point.year.toFixed(1)}</th>
                    <td>{formatSmithCurrency(point.smithNetFinancialPosition)}</td>
                    <td>{formatSmithCurrency(point.baselineNetFinancialPosition)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    </section>
  </div>
</section>

<script>
  import {
    SmithComputationLimitError,
    runSmithScenario,
    validateSmithInputs,
    type SmithInputs,
    type SmithResult,
  } from '../../lib/calculators/smithManoeuvre';
  import {
    SMITH_DEFAULT_INPUTS,
    SMITH_SOFT_RANGES,
    buildSmithAnnualSeries,
    buildSmithChartGeometry,
    formatSmithAxisCurrency,
    formatSmithCurrency,
    formatSmithCurrencyDetailed,
    formatSmithPayoffMonth,
    formatSmithPercent,
  } from '../../lib/calculators/smithManoeuvreView';

  const root = document.querySelector<HTMLElement>('[data-smith-calculator]');

  if (root) {
    type FieldName = keyof SmithInputs;
    const fieldNames: FieldName[] = [
      'homeValue',
      'mortgageBalance',
      'quotedMortgageRate',
      'remainingAmortizationYears',
      'annualHelocRate',
      'expectedAnnualInvestmentReturn',
      'horizonYears',
      'marginalTaxRateProxy',
      'deductibleInterestAssumption',
    ];
    const percentageFields = new Set<FieldName>([
      'quotedMortgageRate',
      'annualHelocRate',
      'expectedAnnualInvestmentReturn',
      'marginalTaxRateProxy',
      'deductibleInterestAssumption',
    ]);
    const wholeYearFields = new Set<FieldName>(['remainingAmortizationYears', 'horizonYears']);

    const inputFor = (field: FieldName) => root.querySelector<HTMLInputElement>(`[data-smith-field="${field}"]`)!;
    const errorFor = (field: FieldName) => root.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!;
    const warningFor = (field: FieldName) => root.querySelector<HTMLElement>(`[data-warning-for="${field}"]`)!;
    const status = root.querySelector<HTMLElement>('[data-smith-status]')!;

    const friendlyErrors: Record<FieldName, string> = {
      homeValue: 'Enter a home value greater than $0.',
      mortgageBalance: 'Enter a non-negative mortgage balance no greater than 80% of home value.',
      quotedMortgageRate: 'Enter a non-negative quoted annual mortgage rate.',
      remainingAmortizationYears: 'Enter a positive whole number of remaining amortization years.',
      annualHelocRate: 'Enter a non-negative annual HELOC rate.',
      expectedAnnualInvestmentReturn: 'Expected annual return must be greater than -100%.',
      horizonYears: 'Enter a positive whole number of scenario years.',
      marginalTaxRateProxy: 'Enter a marginal tax-rate proxy from 0% to 100%.',
      deductibleInterestAssumption: 'Enter a deductible-interest assumption from 0% to 100%.',
    };

    function clearFeedback() {
      for (const field of fieldNames) {
        const input = inputFor(field);
        const error = errorFor(field);
        const warning = warningFor(field);
        input.removeAttribute('aria-invalid');
        error.hidden = true;
        error.textContent = '';
        warning.hidden = true;
        warning.textContent = '';
      }
      status.textContent = '';
    }

    function showError(field: FieldName, message = friendlyErrors[field]) {
      const input = inputFor(field);
      const error = errorFor(field);
      input.setAttribute('aria-invalid', 'true');
      error.textContent = message;
      error.hidden = false;
    }

    function fieldFromEngineError(message: string): FieldName | null {
      if (message.includes('homeValue')) return 'homeValue';
      if (message.includes('mortgageBalance')) return 'mortgageBalance';
      if (message.includes('quotedMortgageRate')) return 'quotedMortgageRate';
      if (message.includes('remainingAmortizationYears')) return 'remainingAmortizationYears';
      if (message.includes('annualHelocRate')) return 'annualHelocRate';
      if (message.includes('expectedAnnualInvestmentReturn')) return 'expectedAnnualInvestmentReturn';
      if (message.includes('horizonYears')) return 'horizonYears';
      if (message.includes('marginalTaxRateProxy')) return 'marginalTaxRateProxy';
      if (message.includes('deductibleInterestAssumption')) return 'deductibleInterestAssumption';
      return null;
    }

    function readInputs(): SmithInputs | null {
      const raw = {} as Record<FieldName, number>;
      let hasError = false;
      for (const field of fieldNames) {
        const value = inputFor(field).valueAsNumber;
        if (!Number.isFinite(value)) {
          showError(field, 'Enter a numeric value.');
          hasError = true;
          continue;
        }
        if (wholeYearFields.has(field) && !Number.isInteger(value)) {
          showError(field);
          hasError = true;
        }
        raw[field] = percentageFields.has(field) ? value / 100 : value;
      }
      if (hasError) return null;

      const inputs = raw as SmithInputs;
      const engineErrors = validateSmithInputs(inputs);
      for (const engineError of engineErrors) {
        const field = fieldFromEngineError(engineError);
        if (field) showError(field);
      }
      if (engineErrors.length > 0) return null;

      for (const [field, range] of Object.entries(SMITH_SOFT_RANGES) as [keyof typeof SMITH_SOFT_RANGES, { min: number; max: number }][]) {
        const value = inputs[field];
        if (value < range.min || value > range.max) {
          const warning = warningFor(field);
          warning.textContent = 'Outside the usual calculator range; the mathematical model still accepts this value.';
          warning.hidden = false;
        }
      }
      return inputs;
    }

    function setOutput(name: string, value: string) {
      const node = root.querySelector<HTMLElement>(`[data-output="${name}"]`);
      if (node) node.textContent = value;
    }

    function createSvgElement<K extends keyof SVGElementTagNameMap>(name: K) {
      return document.createElementNS('http://www.w3.org/2000/svg', name);
    }

    function renderChart(result: SmithResult) {
      const series = buildSmithAnnualSeries(result);
      const geometry = buildSmithChartGeometry(series);
      const svg = root.querySelector<SVGSVGElement>('[data-smith-chart]')!;
      svg.setAttribute('viewBox', `0 0 ${geometry.width} ${geometry.height}`);

      const grid = root.querySelector<SVGGElement>('[data-chart-grid]')!;
      grid.replaceChildren();
      for (const tick of geometry.ticks) {
        const group = createSvgElement('g');
        const line = createSvgElement('line');
        line.setAttribute('x1', String(geometry.left));
        line.setAttribute('y1', String(tick.y));
        line.setAttribute('x2', String(geometry.width - geometry.right));
        line.setAttribute('y2', String(tick.y));
        const label = createSvgElement('text');
        label.setAttribute('x', String(geometry.left - 10));
        label.setAttribute('y', String(tick.y + 4));
        label.setAttribute('text-anchor', 'end');
        label.textContent = formatSmithAxisCurrency(tick.value);
        group.append(line, label);
        grid.append(group);
      }
      const zeroLine = createSvgElement('line');
      zeroLine.setAttribute('class', 'smith-zero-line');
      zeroLine.setAttribute('x1', String(geometry.left));
      zeroLine.setAttribute('y1', String(geometry.zeroY));
      zeroLine.setAttribute('x2', String(geometry.width - geometry.right));
      zeroLine.setAttribute('y2', String(geometry.zeroY));
      grid.append(zeroLine);

      const startLabel = createSvgElement('text');
      startLabel.setAttribute('class', 'smith-x-label');
      startLabel.setAttribute('x', String(geometry.left));
      startLabel.setAttribute('y', String(geometry.height - 14));
      startLabel.textContent = '0';
      const endLabel = createSvgElement('text');
      endLabel.setAttribute('class', 'smith-x-label');
      endLabel.setAttribute('x', String(geometry.width - geometry.right));
      endLabel.setAttribute('y', String(geometry.height - 14));
      endLabel.setAttribute('text-anchor', 'end');
      endLabel.textContent = `${result.inputs.horizonYears} years`;
      grid.append(startLabel, endLabel);

      root.querySelector<SVGPathElement>('[data-chart-path="smith"]')!.setAttribute('d', geometry.smithPath);
      root.querySelector<SVGPathElement>('[data-chart-path="baseline"]')!.setAttribute('d', geometry.baselinePath);

      const pointGroup = root.querySelector<SVGGElement>('[data-chart-points]')!;
      pointGroup.replaceChildren();
      for (const point of geometry.points) {
        const dataPoint = createSvgElement('g');
        dataPoint.setAttribute('data-chart-point', '');
        dataPoint.dataset.year = String(point.year);
        dataPoint.dataset.smith = String(point.smithNetFinancialPosition);
        dataPoint.dataset.baseline = String(point.baselineNetFinancialPosition);
        pointGroup.append(dataPoint);
      }

      const body = root.querySelector<HTMLTableSectionElement>('[data-comparison-table]')!;
      body.replaceChildren();
      for (const point of series) {
        const row = document.createElement('tr');
        row.setAttribute('data-comparison-row', '');
        row.dataset.year = String(point.year);
        row.dataset.smith = String(point.smithNetFinancialPosition);
        row.dataset.baseline = String(point.baselineNetFinancialPosition);
        const year = document.createElement('th');
        year.scope = 'row';
        year.textContent = Number.isInteger(point.year) ? String(point.year) : point.year.toFixed(1);
        const smith = document.createElement('td');
        smith.textContent = formatSmithCurrency(point.smithNetFinancialPosition);
        const baseline = document.createElement('td');
        baseline.textContent = formatSmithCurrency(point.baselineNetFinancialPosition);
        row.append(year, smith, baseline);
        body.append(row);
      }
    }

    function renderResult(result: SmithResult) {
      setOutput('netDifference', formatSmithCurrency(result.illustrativeNetPositionDifference));
      setOutput('smithMortgage', formatSmithCurrency(result.endingMortgageBalance));
      setOutput('smithHeloc', formatSmithCurrency(result.endingHelocBalance));
      setOutput('smithPortfolio', formatSmithCurrency(result.endingSmithTaxablePortfolio));
      setOutput('smithNet', formatSmithCurrency(result.smithNetFinancialPosition));
      setOutput('baselineMortgage', formatSmithCurrency(result.endingBaselineMortgageBalance));
      setOutput('baselinePortfolio', formatSmithCurrency(result.endingBaselinePortfolio));
      setOutput('baselineNet', formatSmithCurrency(result.baselineNetFinancialPosition));
      setOutput('mortgageBudget', formatSmithCurrencyDetailed(result.scheduledMonthlyMortgageBudget));
      setOutput('helocInterest', formatSmithCurrency(result.cumulativeHelocInterestPaid));
      setOutput('taxOffset', formatSmithCurrency(result.estimatedCumulativeTaxOffset));
      setOutput('maxLtv', formatSmithPercent(result.maxSecuredLtv));
      setOutput('endingLtv', formatSmithPercent(result.endingSecuredLtv));
      setOutput('smithPayoff', formatSmithPayoffMonth(result.smithMortgagePayoffMonth));
      setOutput('baselinePayoff', formatSmithPayoffMonth(result.baselineMortgagePayoffMonth));
      root.dataset.externalCashBudgetDifference = String(result.externalCashBudgetDifference);
      const horizon = root.querySelector<HTMLElement>('[data-horizon-label]');
      if (horizon) horizon.textContent = `${result.inputs.horizonYears}-year scenario`;
      renderChart(result);
    }

    function calculate() {
      clearFeedback();
      const inputs = readInputs();
      if (!inputs) {
        status.textContent = 'Review the highlighted fields.';
        return;
      }
      try {
        const result = runSmithScenario(inputs);
        renderResult(result);
        status.textContent = 'Scenario updated.';
      } catch (error) {
        if (error instanceof SmithComputationLimitError) {
          showError('horizonYears', 'This horizon exceeds the calculator computation limit. Choose a shorter horizon.');
          status.textContent = 'Review the highlighted field.';
          return;
        }
        status.textContent = 'This scenario could not be calculated. Review the inputs and try again.';
      }
    }

    function resetDefaults() {
      for (const field of fieldNames) {
        const value = SMITH_DEFAULT_INPUTS[field];
        inputFor(field).value = String(percentageFields.has(field) ? value * 100 : value);
      }
      calculate();
    }

    root.querySelector<HTMLButtonElement>('[data-update-scenario]')!.addEventListener('click', calculate);
    root.querySelector<HTMLButtonElement>('[data-reset-defaults]')!.addEventListener('click', resetDefaults);
    for (const field of fieldNames) {
      inputFor(field).addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          calculate();
        }
      });
    }
  }
</script>


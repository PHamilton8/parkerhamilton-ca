---
import SmithManoeuvreCalculatorBase from './SmithManoeuvreCalculatorBase.astro';
---

<SmithManoeuvreCalculatorBase />

<script>
  const root = document.querySelector<HTMLElement>('[data-smith-calculator]');
  if (root) {
    const setText = (selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };
    const setLabel = (selector: string, text: string, unit: string) => {
      const node = root.querySelector<HTMLLabelElement>(selector);
      if (!node) return;
      node.replaceChildren(document.createTextNode(`${text} `));
      const span = document.createElement('span');
      span.textContent = unit;
      node.append(span);
    };

    const privacy = root.querySelector<HTMLElement>('.smith-boundary > span');
    if (privacy) privacy.textContent = 'Calculations stay in your browser.';

    setText('#hint-mortgageBalance', 'Must be no more than 80% of home value in this model.');
    setText('#hint-remainingAmortizationYears', '1–30 whole years.');
    setText('#hint-horizonYears', '1–40 whole years.');
    setLabel('label[for="smith-mortgage-rate"]', 'Mortgage rate', '(%)');
    setText('#hint-quotedMortgageRate', 'Uses the Canadian semi-annual compounding convention.');
    setLabel('label[for="smith-heloc-rate"]', 'HELOC rate', '(%)');
    setText('#hint-expectedAnnualInvestmentReturn', 'Assumed constant annual return for this scenario.');
  }
</script>
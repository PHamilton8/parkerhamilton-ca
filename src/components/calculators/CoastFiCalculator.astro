  .mode-fieldset { margin: 0; padding: 0 0 1.5rem; border: 0; }
  .mode-fieldset legend { margin-bottom: 0.65rem; color: var(--color-muted); font-size: 0.8rem; font-weight: 760; }
  .mode-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.55rem; }
  .mode-option { position: relative; min-width: 0; }
  .mode-option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .mode-option label { min-height: 5.5rem; padding: 0.8rem 0.85rem; display: flex; flex-direction: column; justify-content: center; gap: 0.2rem; border: 1px solid var(--color-line); border-radius: 0.7rem; background: var(--color-canvas); cursor: pointer; }
  .mode-option label strong { font-size: 0.86rem; line-height: 1.2; }
  .mode-option label span { color: var(--color-muted); font-size: 0.72rem; line-height: 1.35; }
  .mode-option input:checked + label { border-color: var(--color-deep-teal); background: var(--color-deep-teal); color: var(--color-on-deep); }

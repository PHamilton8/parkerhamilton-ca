<section class="coast-calculator" data-coast-calculator>
  <header class="tool-heading">
    <p class="tool-kicker">Interactive planning model</p>
    <h2>Coast FI calculator</h2>
    <p>Use one of four modes to compare your portfolio with the Coast threshold, solve for a target-age contribution, estimate a Coast age, or solve for the full retirement-target contribution.</p>
  </header>

  <form data-coast-form novalidate>
    <fieldset class="mode-fieldset">
      <legend>Choose a question</legend>
      <div class="mode-grid">
        <div class="mode-option">
          <input type="radio" id="coast-mode-a" name="coast-mode" value="A" checked />
          <label for="coast-mode-a"><strong>Where am I now?</strong><span>Compare your portfolio with today's Coast threshold.</span></label>
        </div>
        <div class="mode-option">
          <input type="radio" id="coast-mode-b" name="coast-mode" value="B" />
          <label for="coast-mode-b"><strong>Coast by age</strong><span>Solve the monthly contribution needed by a target age.</span></label>
        </div>
        <div class="mode-option">
          <input type="radio" id="coast-mode-c" name="coast-mode" value="C" />
          <label for="coast-mode-c"><strong>When could I Coast?</strong><span>Estimate the first Coast month at a chosen contribution.</span></label>
        </div>
        <div class="mode-option">
          <input type="radio" id="coast-mode-d" name="coast-mode" value="D" />
          <label for="coast-mode-d"><strong>Retirement target</strong><span>Solve the contribution needed for the full target.</span></label>
        </div>
      </div>
    </fieldset>

    <div class="workbench">
      <section class="input-panel" aria-labelledby="coast-inputs-title">
        <div class="panel-heading">
          <p class="step-label">01</p>
          <div>
            <h3 id="coast-inputs-title">Your assumptions</h3>
            <p>All money values are in today's dollars.</p>
          </div>
        </div>

        <div class="field-grid">
          <div class="field">
            <label for="coast-current-age">Current age <span>years</span></label>
            <input id="coast-current-age" name="current-age" type="number" inputmode="numeric" min="18" max="100" step="1" value="30" aria-describedby="coast-current-age-help coast-current-age-error" />
            <p class="field-help" id="coast-current-age-help">Whole years, 18–100.</p>
            <p class="field-error" id="coast-current-age-error" data-error-for="current-age" hidden></p>
          </div>

          <div class="field">
            <label for="coast-retirement-age">Target retirement age <span>years</span></label>
            <input id="coast-retirement-age" name="retirement-age" type="number" inputmode="numeric" min="18" max="100" step="1" value="65" aria-describedby="coast-retirement-age-help coast-retirement-age-error" />
            <p class="field-help" id="coast-retirement-age-help">Whole years, 18–100.</p>
            <p class="field-error" id="coast-retirement-age-error" data-error-for="retirement-age" hidden></p>
          </div>

          <div class="field field-wide">
            <label for="coast-current-portfolio">Current invested portfolio <span>CAD</span></label>
            <div class="input-with-unit input-with-prefix">
              <span aria-hidden="true">$</span>
              <input id="coast-current-portfolio" name="current-portfolio" type="number" inputmode="decimal" min="0" step="1000" value="100000" aria-describedby="coast-current-portfolio-help coast-current-portfolio-error" />
            </div>
            <p class="field-help" id="coast-current-portfolio-help">Invested assets included in this simplified model.</p>
            <p class="field-error" id="coast-current-portfolio-error" data-error-for="current-portfolio" hidden></p>
          </div>

          <div class="field field-wide">
            <label for="coast-retirement-target">Retirement portfolio target <span>today's dollars</span></label>
            <div class="input-with-unit input-with-prefix">
              <span aria-hidden="true">$</span>
              <input id="coast-retirement-target" name="retirement-target" type="number" inputmode="decimal" min="0.01" step="10000" value="1000000" aria-describedby="coast-retirement-target-help coast-retirement-target-error" />
            </div>
            <p class="field-help" id="coast-retirement-target-help">A positive invested-portfolio target, before taxes or fees.</p>
            <p class="field-error" id="coast-retirement-target-error" data-error-for="retirement-target" hidden></p>
          </div>

          <div class="field field-wide">
            <label for="coast-real-return">Expected real annual return <span>after inflation</span></label>
            <div class="input-with-unit input-with-suffix">
              <input id="coast-real-return" name="real-return" type="number" inputmode="decimal" max="20" step="0.1" value="5" aria-describedby="coast-real-return-help coast-real-return-error" />
              <span aria-hidden="true">%</span>
            </div>
            <p class="field-help" id="coast-real-return-help">Must be greater than −100% and no more than 20%.</p>
            <p class="field-error" id="coast-real-return-error" data-error-for="real-return" hidden></p>
          </div>

          <div class="field field-wide mode-specific" data-mode-b hidden>
            <label for="coast-target-age">Target Coast age <span>years</span></label>
            <input id="coast-target-age" name="target-coast-age" type="number" inputmode="numeric" min="18" max="100" step="1" value="45" aria-describedby="coast-target-age-help coast-target-age-error" />
            <p class="field-help" id="coast-target-age-help">Between your current age and retirement age.</p>
            <p class="field-error" id="coast-target-age-error" data-error-for="target-coast-age" hidden></p>
          </div>

          <div class="field field-wide mode-specific" data-mode-c hidden>
            <label for="coast-monthly-contribution">Monthly contribution <span>today's dollars</span></label>
            <div class="input-with-unit input-with-prefix">
              <span aria-hidden="true">$</span>
              <input id="coast-monthly-contribution" name="monthly-contribution" type="number" inputmode="decimal" min="0" step="25" value="500" aria-describedby="coast-monthly-contribution-help coast-monthly-contribution-error" />
            </div>
            <p class="field-help" id="coast-monthly-contribution-help">A constant real contribution made at month-end.</p>
            <p class="field-error" id="coast-monthly-contribution-error" data-error-for="monthly-contribution" hidden></p>
          </div>
        </div>

        <div class="form-actions">
          <button class="calculate-button" type="submit">Calculate</button>
          <button class="reset-button" type="button" data-reset>Reset to example</button>
        </div>
      </section>

      <section class="result-panel" aria-labelledby="coast-results-title">
        <div class="panel-heading">
          <p class="step-label">02</p>
          <div>
            <h3 id="coast-results-title">Projected result</h3>
            <p data-mode-helper>Compare your current invested portfolio with the Coast threshold implied by your retirement target, age, and real-return assumption.</p>
          </div>
        </div>

        <div class="calculation-error" data-calculation-error role="alert" hidden></div>
        <div data-result-content>
          <p class="answer-copy" data-answer role="status" aria-live="polite"></p>
          <div class="primary-result">
            <span data-primary-label></span>
            <strong data-primary-value></strong>
            <small data-primary-note></small>
          </div>
          <dl class="metric-grid" data-metrics></dl>
          <div class="assumption-warning" data-return-warning hidden>
            <strong>High return assumption</strong>
            <span>A real return above 10% is an aggressive assumption. Small changes in long-term return assumptions can materially change the result.</span>
          </div>
          <p class="assumptions-line" data-assumptions></p>
        </div>
      </section>
    </div>
  </form>

  <figure class="trajectory" data-chart-figure>
    <figcaption>
      <div>
        <p class="step-label">03</p>
        <h3>Projected portfolio and Coast threshold</h3>
      </div>
      <p data-chart-summary></p>
    </figcaption>

    <div class="chart-wrap">
      <svg data-chart viewBox="0 0 760 360" role="img" aria-labelledby="coast-chart-title coast-chart-desc" preserveAspectRatio="xMidYMid meet">
        <title id="coast-chart-title">Projected portfolio and Coast threshold by age</title>
        <desc id="coast-chart-desc" data-chart-desc>The chart updates after a valid calculation. Exact selected values are also available in the table below.</desc>
        <g class="chart-grid" aria-hidden="true">
          <line data-grid="0" x1="76" x2="730"></line>
          <line data-grid="1" x1="76" x2="730"></line>
          <line data-grid="2" x1="76" x2="730"></line>
        </g>
        <g class="chart-axis-labels" aria-hidden="true">
          <text data-y-label="0" x="66" text-anchor="end"></text>
          <text data-y-label="1" x="66" text-anchor="end"></text>
          <text data-y-label="2" x="66" text-anchor="end"></text>
          <text data-x-label="start" y="338" text-anchor="start"></text>
          <text data-x-label="middle" y="338" text-anchor="middle"></text>
          <text data-x-label="end" y="338" text-anchor="end"></text>
        </g>
        <path class="threshold-path" data-threshold-path d=""></path>
        <path class="portfolio-path" data-portfolio-path d=""></path>
        <g data-chart-markers aria-hidden="true"></g>
      </svg>
    </div>

    <div class="chart-key" aria-label="Chart series">
      <span><i class="portfolio-key" aria-hidden="true"></i>Projected portfolio</span>
      <span><i class="threshold-key" aria-hidden="true"></i>Coast threshold</span>
    </div>
    <p class="marker-summary" data-marker-summary></p>

    <details class="projection-table-details">
      <summary>View selected projection points</summary>
      <div class="projection-table-wrap">
        <table>
          <caption>Selected annual points from the same projection shown in the chart.</caption>
          <thead><tr><th scope="col">Age</th><th scope="col">Projected portfolio</th><th scope="col">Coast threshold</th></tr></thead>
          <tbody data-projection-table></tbody>
        </table>
      </div>
    </details>
  </figure>

  <div class="method-grid">
    <details>
      <summary>Assumptions and method</summary>
      <div class="detail-copy">
        <p>All values use today's dollars and an expected real annual return. Monthly contributions are treated as constant real contributions made at month-end.</p>
        <p>The audited calculation engine converts the annual real return to an effective monthly rate, compares projected portfolio values with the Coast threshold on a whole-month grid, and keeps full precision until values are formatted for display.</p>
        <p>Taxes, fees, account rules, pensions, changing contribution schedules, withdrawals, and market uncertainty are outside this calculator.</p>
      </div>
    </details>
    <aside class="disclaimer" aria-label="Educational disclaimer">
      <strong>Educational planning model only.</strong>
      <p>Results are illustrative and depend heavily on the return assumption and future circumstances. The calculator uses today's dollars, a constant real return, and simplified contribution assumptions; it excludes taxes, fees, account rules, and market uncertainty. This is not financial advice.</p>
    </aside>
  </div>
</section>

<script>
  import '../../scripts/coastFiCalculator';
</script>

<style>

    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 0.3rem 1.2rem rgb(19 48 47 / 0.035);
  }
  .tool-heading { max-width: 55rem; padding: clamp(0.5rem, 1.5vw, 1rem) clamp(0.25rem, 1vw, 0.75rem) 1.5rem; }
  .tool-kicker, .step-label { margin: 0; color: var(--color-teal); font-size: var(--text-xs); line-height: 1.3; font-weight: 820; letter-spacing: 0.12em; text-transform: uppercase; }
  .tool-heading h2 { margin: 0.35rem 0 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.03; letter-spacing: -0.045em; }

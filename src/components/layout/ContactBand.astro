---
import { site } from '../../data/site';
---
<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <p class="eyebrow">Contact</p>
  <h2 id="contact-title">Have a question?</h2>
  <div class="contact-actions">
    <a class="contact-email-action" href={`mailto:${site.email}`}><span>Email</span><span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  /* Canonical site-wide Email CTA: final owner-approved Homepage V3 treatment. */
  .contact-email-action {
    min-width: 126px;
    min-height: 44px;
    padding: 11px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 0;
    border-radius: 12px;
    background: #f4f7f4;
    color: #0a4f4a;
    box-shadow: none;
    font-size: 15px;
    line-height: normal;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .contact-email-action:hover {
    transform: translateY(-1px);
    background: #fff;
    color: #073f3b;
  }

  .contact-email-action span:last-child {
    color: currentColor;
    font-size: 22px;
    line-height: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .contact-email-action {
      min-width: 126px;
      min-height: 44px;
      padding: 11px 14px;
      border-radius: 12px;
      font-size: 11px;
    }

    .contact-email-action span:last-child {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .contact-email-action {
      width: 118px;
      min-width: 118px;
      min-height: 44px;
      padding: 10px 13px;
      border-radius: 11px;
    }
  }
</style>

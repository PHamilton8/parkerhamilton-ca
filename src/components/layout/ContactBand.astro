---
import { site } from '../../data/site';
---
<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <p class="eyebrow">Contact</p>
  <h2 id="contact-title">Have a question?</h2>
  <div class="contact-actions">
    <a class="contact-action primary" href={`mailto:${site.email}`}><span>Email</span><span aria-hidden="true">↗</span></a>
  </div>
</section>

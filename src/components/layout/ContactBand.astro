---
import { site } from '../../data/site';
---
<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <p class="eyebrow">Contact</p>
  <h2 id="contact-title">Have a question?</h2>
  <div class="contact-actions">
    <a class="contact-email-action" href={`mailto:${site.email}`}>
      <span>Email</span>
      <svg class="contact-email-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M4.75 11.25 11.25 4.75M6.25 4.75h5v5" />
      </svg>
    </a>
  </div>
</section>

<style>
  /* Canonical site-wide ContactBand: exact final owner-approved Homepage V3 treatment. */
  .contact-band {
    width: min(calc(100% - 40px), 1400px);
    max-width: 1400px;
    margin: 42px auto 0;
    padding: 42px 36px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'eyebrow actions' 'title actions';
    column-gap: 28px;
    row-gap: 16px;
    align-items: center;
    border-radius: 26px;
    background: linear-gradient(180deg, #0a4f4a 0%, #084843 100%);
    color: #f8fbfa;
  }

  .contact-band > .eyebrow {
    grid-area: eyebrow;
    margin: 0;
    color: #9fd1ca;
    font-size: 12px;
    line-height: normal;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-band > h2 {
    grid-area: title;
    margin: 0;
    max-width: none;
    color: #f8fbfa;
    font-size: 74px;
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: -0.055em;
  }

  .contact-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
  }

  .contact-email-action {
    min-width: 126px;
    min-height: 44px;
    padding: 11px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    overflow: hidden;
    border: 0;
    border-radius: 12px;
    background: #f4f7f4;
    color: #0a4f4a;
    box-shadow: none;
    font-size: 15px;
    line-height: normal;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .contact-email-action:hover {
    transform: translateY(-1px);
    background: #fff;
    color: #073f3b;
  }

  .contact-email-arrow {
    display: block;
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: currentColor;
  }

  .contact-email-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 1180px) {
    .contact-band > h2 { font-size: 64px; }
  }

  @media (max-width: 980px) {
    .contact-band {
      margin-top: 28px;
      padding: 18px 16px;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'eyebrow actions' 'title actions';
      row-gap: 10px;
      align-items: center;
      border-radius: 16px;
    }

    .contact-band > .eyebrow {
      margin: 0;
      font-size: 10px;
    }

    .contact-band > h2 { font-size: 28px; }

    .contact-email-action {
      min-width: 126px;
      min-height: 44px;
      padding: 11px 14px;
      border-radius: 12px;
      font-size: 11px;
    }

    .contact-email-arrow {
      width: 12px;
      height: 12px;
      flex-basis: 12px;
    }
  }

  @media (max-width: 480px) {
    .contact-band {
      width: calc(100% - 16px);
      margin-top: 18px;
      padding: 18px 16px;
      grid-template-columns: 1fr;
      grid-template-areas: 'eyebrow' 'title' 'actions';
      row-gap: 0;
      align-items: start;
    }

    .contact-band > .eyebrow {
      margin: 0 0 10px;
      font-size: 10px;
    }

    .contact-band > h2 { font-size: 18px; }

    .contact-actions {
      width: auto;
      margin-top: 28px;
    }

    .contact-email-action {
      width: 118px;
      min-width: 118px;
      min-height: 44px;
      padding: 10px 13px;
      border-radius: 11px;
    }
  }
</style>

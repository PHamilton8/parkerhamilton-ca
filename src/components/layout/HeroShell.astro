---
import { site } from '../../data/site';
---
<section class="hero page-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Researcher Who Builds · Applied Problem Solver</p>
    <h1 id="hero-title">Researcher who <span>builds things.</span></h1>
    <p class="hero-lede">I investigate problems, figure out what matters, and build useful things around what I learn.</p>
    <p class="credential">{site.credential}</p>
    <a class="hero-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
  </div>
  <div class="hero-visual-zone" aria-label="Reserved integration zone for the independently developed homepage hero visual.">
    <div><strong>Hero visual in development</strong><span>Reserved integration zone</span></div>
  </div>
</section>

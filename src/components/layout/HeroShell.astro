---
import { site } from '../../data/site';
import CathedralMonument from '../visualization/CathedralMonument.astro';
---
<section class="hero page-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Researcher Who Builds · Applied Problem Solver</p>
    <h1 id="hero-title">Researcher who <span>builds things.</span></h1>
    <p class="hero-lede">I investigate problems, figure out what matters, and build useful things around what I learn.</p>
    <p class="credential">{site.credential}</p>
    <a class="hero-link" href="#work">Explore my work <span aria-hidden="true">→</span></a>
  </div>
  <div class="hero-visual-zone hero-monument-zone">
    <CathedralMonument />
  </div>
</section>

<style>
  .hero-monument-zone {
    padding: clamp(0.35rem, 1.2vw, 1rem);
    background: #f4f5f2;
  }

  .hero-monument-zone::before {
    content: none;
  }
</style>

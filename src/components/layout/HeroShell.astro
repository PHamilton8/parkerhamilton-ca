---
import CathedralMonument from '../visualization/CathedralMonument.astro';
---
<section class="hero page-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title" aria-label="I like figuring things out."><span class="h1-line h1-line-1">I like</span> <span class="h1-line h1-line-2">figuring</span> <span class="h1-line h1-line-3">things out.</span></h1>
    <p class="hero-lede">Most of my projects start with a research question or something I think could work better.</p>
    <p class="credential">MSc · Marketing Research & Behavioural Science</p>
    <a class="hero-link" href="#work">Explore my work <span aria-hidden="true">→</span></a>
  </div>
  <div class="hero-visual-zone hero-monument-zone">
    <CathedralMonument />
  </div>
</section>

<style>
  .hero-monument-zone {
    height: 27.5rem;
    aspect-ratio: auto;
    padding: 0;
    background:
      radial-gradient(88% 90% at 48% 44%, rgba(199, 231, 225, 0.88), rgba(244, 248, 245, 0.99) 66%),
      linear-gradient(145deg, #F2F6F3, #E9F2EF);
    box-shadow:
      inset 0 0 0 1px rgba(7, 63, 60, 0.08),
      0 16px 32px rgba(3, 39, 37, 0.07);
  }

  .hero-monument-zone::before {
    content: none;
  }

  @media (max-width: 51.25rem) {
    .hero-monument-zone { height: 16.25rem; }
  }

  @media (max-width: 35rem) {
    .hero-monument-zone {
      height: 10.75rem;
    }
  }
</style>

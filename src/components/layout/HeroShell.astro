---
import CathedralMonument from '../visualization/CathedralMonument.astro';
---
<section class="hero page-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">I like figuring things out.</h1>
    <p class="hero-lede">Most of my projects start with a research question or something I think could work better.</p>
    <p class="credential">MSc · Marketing Research & Behavioural Science</p>
    <a class="hero-link" href="#work">Explore my work <span aria-hidden="true">→</span></a>
  </div>
  <div class="hero-visual-zone hero-monument-zone">
    <CathedralMonument />
  </div>
</section>

<style>
  .hero-monument-zone {
    height: 27.5rem;
    aspect-ratio: auto;
    padding: 0;
    background: #f4f5f2;
  }

  .hero-monument-zone::before {
    content: none;
  }

  @media (max-width: 51.25rem) {
    .hero-monument-zone { height: 16.25rem; }
  }

  @media (max-width: 35rem) {
    .hero-monument-zone {
      height: 10.75rem;
    }
  }
</style>

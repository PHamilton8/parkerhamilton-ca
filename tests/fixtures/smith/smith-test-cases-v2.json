      "checks": ["finite","helocInterestZero","taxOffsetZero","cashBudgetEqual","golden"],
      "expected": {"endingSmithTaxablePortfolio":828875.4554046297,"endingBaselinePortfolio":0,"cumulativeHelocInterestPaid":0,"estimatedCumulativeTaxOffset":0,"illustrativeNetPositionDifference":408875.4554046347}
